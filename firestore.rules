rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Everyone who opens the app is signed in anonymously; nothing can be deleted.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /players/{playerId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20;
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2;
    }
  }
}
